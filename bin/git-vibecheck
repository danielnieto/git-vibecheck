#!/usr/bin/env bash
#
# git vibecheck: a per-branch checklist of the files a human has approved.
#
# Approvals live in refs/review/<branch>: a commit whose parent is the branch's
# merge base and whose tree is that base with every approved file overlaid at
# the content it had when approved (or, for a file approved hunk by hunk, the
# base plus the approved hunks). A file is approved only while the working tree
# matches that overlay, so any later edit sends it back to pending. A second
# parent records each file as it was the last time any of it was approved,
# which tells a partly approved file from one that changed since. Commits, the
# index and the stash are never touched.
#
# Must stay compatible with bash 3.2 (the macOS /bin/bash).

set -euo pipefail

NOT_STARTED=3

usage() {
  cat <<'EOF'
usage: git vibecheck [--base <branch>]     start reviewing this branch, or show its checklist
   or: git vibecheck pending               list the files still waiting for approval
   or: git vibecheck approve <path>...     approve files at their current content
   or: git vibecheck unapprove <path>...   send approved files back to pending

  [x] approved   [-] partly approved   [~] changed since approved   [ ] never reviewed

`git vibecheck pending` exits 0 only when nothing is left to review.

Plumbing, for editor and agent integrations:
   git vibecheck pending-diff [<path>...]  what is left to review, as a unified diff
   git vibecheck approve-patch < <patch>   approve the changes in a patch of what is left
EOF
}

die() {
  printf 'git vibecheck: %s\n' "$1" >&2
  exit "${2:-2}"
}

g() {
  git -c core.quotePath=false "$@"
}

default_base() {
  if git symbolic-ref -q --short refs/remotes/origin/HEAD; then
    return
  elif git rev-parse -q --verify refs/heads/main >/dev/null; then
    echo main
  else
    echo master
  fi
}

base_name() {
  git config --get "$base_key" || default_base
}

merge_base() {
  local name
  name=$(base_name)
  git merge-base "$name" HEAD 2>/dev/null || die "no common ancestor between $name and HEAD"
}

require_started() {
  [ "$state" != "$zero" ] || die "this branch is not under review; run \`git vibecheck\` to start" "$NOT_STARTED"
}

commit_tree() {
  GIT_AUTHOR_NAME=git-vibecheck GIT_AUTHOR_EMAIL=git-vibecheck@localhost \
    GIT_COMMITTER_NAME=git-vibecheck GIT_COMMITTER_EMAIL=git-vibecheck@localhost \
    git commit-tree "$@" -m "git vibecheck: $branch"
}

# Point the review ref at a commit of <tree>, the approved content. Its first
# parent is <parent>, the merge base both trees were built on, so later runs
# can tell when a rebase or merge moved it. Its second parent is a commit of
# <seen>: each file as the working tree had it the last time any of it was
# approved.
write_ref() {
  local tree=$1 seen=$2 parent=$3 seen_commit commit
  seen_commit=$(commit_tree "$seen" -p "$parent")
  commit=$(commit_tree "$tree" -p "$parent" -p "$seen_commit")
  git update-ref -m "git vibecheck" "$ref" "$commit" "$state" 2>/dev/null ||
    die "the review changed while this command ran; try again"
  state=$commit
}

# The tree of what was last seen. A review written before that was recorded has
# no second parent; its own tree stands in, so a partly approved file shows as
# changed, as it did then.
seen_tree() {
  git rev-parse -q --verify "$state^2^{tree}" || git rev-parse "$state^{tree}"
}

# Print `git update-index --index-info` lines that turn <from> into <to> for
# the given pathspecs (which, like any git pathspec, are relative to the cwd).
index_info() {
  local from=$1 to=$2
  shift 2
  g diff-tree -r --no-renames "$from" "$to" -- "$@" |
    awk -F '\t' -v zero="$zero" '{
      split($1, f, " ")
      if (f[5] == "D") print "0 " zero "\t" $2
      else print f[2] " " f[4] "\t" $2
    }'
}

# Print <tree> with the entries matching the pathspecs taken from <source>.
overlay_tree() {
  local tree=$1 source=$2 index="$tmp/overlay.index"
  shift 2
  GIT_INDEX_FILE=$index git read-tree "$tree"
  index_info "$tree" "$source" "$@" | GIT_INDEX_FILE=$index git -C "$top" update-index --index-info
  GIT_INDEX_FILE=$index git write-tree
}

# Record the entries matching the pathspecs at their content in <source>, as
# both approved and seen: the working tree to approve, the base to unapprove.
overlay() {
  local source=$1 tree seen
  shift
  tree=$(overlay_tree "$ref" "$source" "$@")
  seen=$(overlay_tree "$(seen_tree)" "$source" "$@")
  write_ref "$tree" "$seen" "$base"
}

# Print <tree>'s changes from <old base> redone on top of the current base.
rebase_tree() {
  local old_base=$1 tree=$2 index="$tmp/sync.index"
  GIT_INDEX_FILE=$index git read-tree "$base"
  index_info "$old_base" "$tree" | GIT_INDEX_FILE=$index git -C "$top" update-index --index-info
  GIT_INDEX_FILE=$index git write-tree
}

# Set $base to the current merge base, first rebuilding the review tree on top
# of it if it moved, so never-reviewed files keep comparing against the base
# the branch actually has now while approvals carry over.
sync_base() {
  local old_base tree seen
  base=$(merge_base)
  old_base=$(git rev-parse "$ref^1")
  if [ "$old_base" != "$base" ]; then
    tree=$(rebase_tree "$old_base" "$ref")
    seen=$(rebase_tree "$old_base" "$(seen_tree)")
    write_ref "$tree" "$seen" "$base"
  fi
}

# Write a tree of the whole working tree, untracked files included, using a
# throwaway copy of the index so the real one is never modified. The copy keeps
# the index's mtime: git compares contents for files modified in the same
# second as the index was written, and a newer copy would trust their stale
# stat data instead.
worktree_tree() {
  local index="$tmp/worktree.index"
  cp -p "$git_dir/index" "$index" 2>/dev/null || :
  GIT_INDEX_FILE=$index git -c advice.addEmbeddedRepo=false -c core.safecrlf=false add -A
  GIT_INDEX_FILE=$index git write-tree
}

# Print "<marker> <path>" for every file that differs from the base.
checklist() {
  local worktree=$1
  g diff-tree -r --name-only --no-renames "$ref" "$worktree" >"$tmp/pending"
  g diff-tree -r --name-only --no-renames "$base" "$ref" >"$tmp/approved"
  g diff-tree -r --name-only --no-renames "$(seen_tree)" "$worktree" >"$tmp/moved"
  g diff-tree -r --name-only --no-renames "$base" "$worktree" |
    awk -v pending="$tmp/pending" -v approved="$tmp/approved" -v moved="$tmp/moved" '
      BEGIN {
        while ((getline line < pending) > 0) p[line] = 1
        while ((getline line < approved) > 0) a[line] = 1
        while ((getline line < moved) > 0) m[line] = 1
      }
      {
        if (!($0 in p)) mark = "[x]"
        else if (!($0 in a)) mark = "[ ]"
        else if ($0 in m) mark = "[~]"
        else mark = "[-]"
        print mark " " $0
      }
    '
}

cmd_start() {
  local requested=$1 list="$tmp/list" total approved tree
  if [ -n "$requested" ]; then
    git rev-parse -q --verify "$requested^{commit}" >/dev/null || die "unknown base: $requested"
    git config "$base_key" "$requested"
  elif ! git config --get "$base_key" >/dev/null; then
    git config "$base_key" "$(default_base)"
  fi

  if [ "$state" = "$zero" ]; then
    base=$(merge_base)
    tree=$(git rev-parse "$base^{tree}")
    write_ref "$tree" "$tree" "$base"
  else
    sync_base
  fi

  checklist "$(worktree_tree)" >"$list"
  total=$(grep -c '' "$list" || :)
  approved=$(grep -c '^\[x\]' "$list" || :)
  printf '%s vs %s: %s/%s approved\n' "$branch" "$(base_name)" "$approved" "$total"
  if [ -s "$list" ]; then
    echo
    cat "$list"
  fi
}

cmd_pending() {
  [ $# -eq 0 ] || die "pending takes no arguments"
  require_started
  sync_base
  checklist "$(worktree_tree)" | grep -v '^\[x\]' >"$tmp/list" || :
  if [ -s "$tmp/list" ]; then
    cat "$tmp/list"
    exit 1
  fi
  if [ -t 1 ]; then
    echo "nothing left to review"
  fi
}

cmd_approve() {
  local worktree
  [ $# -gt 0 ] || die "approve needs at least one path (use . for everything)"
  require_started
  sync_base
  worktree=$(worktree_tree)
  g diff-tree -r --name-only --no-renames "$ref" "$worktree" -- "$@" >"$tmp/matched"
  if [ ! -s "$tmp/matched" ]; then
    if [ -n "$(g diff-tree -r --name-only --no-renames "$base" "$worktree" -- "$@")" ]; then
      echo "already approved: $*"
      return
    fi
    die "no file under review matches: $*"
  fi
  overlay "$worktree" "$@"
  sed 's/^/approved /' "$tmp/matched"
}

cmd_unapprove() {
  [ $# -gt 0 ] || die "unapprove needs at least one path (use . for everything)"
  require_started
  sync_base
  g diff-tree -r --name-only --no-renames "$base" "$ref" -- "$@" >"$tmp/matched"
  if [ ! -s "$tmp/matched" ]; then
    echo "not approved: $*"
    return
  fi
  overlay "$base" "$@"
  sed 's/^/unapproved /' "$tmp/matched"
}

# The part of each file that is still unreviewed, as a unified diff against
# what was approved (or against the base for files never approved).
cmd_pending_diff() {
  local worktree
  require_started
  sync_base
  worktree=$(worktree_tree)
  g diff --no-color --no-ext-diff --no-renames --no-relative \
    --src-prefix=a/ --dst-prefix=b/ "$ref" "$worktree" -- "$@"
}

# Print "<old blob id>\t<path>" for each file in a git-format patch, taking the
# id from the file's index line, or "none" without one (`read` would silently
# drop an empty first field). Fails on renames, copies and quoted paths, which
# approve-patch does not support.
patch_files() {
  awk '
    function flush() {
      if (path != "") print (old == "" ? "none" : old) "\t" path
      old = ""; path = ""; minus = ""
    }
    function strip(name, prefix) {
      sub(/\t$/, "", name)
      if (name == "/dev/null") return name
      if (substr(name, 1, 2) != prefix) exit 1
      return substr(name, 3)
    }
    /^diff --git / { flush(); body = 0; next }
    body && /^[-+ \\]/ { next }
    /^@@ / { body = 1; next }
    /^(rename|copy) (from|to) / { exit 1 }
    /^index / { split($2, ids, /\.\./); old = ids[1]; next }
    /^--- / { minus = strip(substr($0, 5), "a/"); next }
    /^\+\+\+ / {
      path = strip(substr($0, 5), "b/")
      if (path == "/dev/null") path = minus
      next
    }
    END { flush() }
  '
}

# Approve the changes in a patch read from stdin. The patch goes from what is
# approved to the working tree, like any part of `pending-diff`. Each file's
# index line must name the approved version the patch was made from, so a
# patch made before the review changed is refused instead of landing on
# content it was not made for.
cmd_approve_patch() {
  local patch="$tmp/patch" index="$tmp/patch.index" worktree old path approved current tree seen
  [ $# -eq 0 ] || die "approve-patch takes no arguments; pipe the patch to it"
  require_started
  sync_base
  cat >"$patch"
  [ -s "$patch" ] || die "approve-patch needs a patch on stdin"
  patch_files <"$patch" >"$tmp/files" ||
    die "approve-patch takes git-format patches with a/ and b/ paths, without renames, copies or quoted paths"
  [ -s "$tmp/files" ] || die "the patch changes no file"

  worktree=$(worktree_tree)
  g diff-tree -r --name-only --no-renames "$base" "$worktree" >"$tmp/reviewed"
  while IFS=$'\t' read -r old path; do
    grep -qxF -- "$path" "$tmp/reviewed" || die "not under review: $path"
    [ "$old" != none ] || die "the patch has no index line for $path; make it with \`git vibecheck pending-diff\`"
    approved=$(git rev-parse -q --verify "$state:$path" || echo "$zero")
    case $approved in
    "$old"*) ;;
    *) die "$path changed in the review since the patch was made; make the patch again" ;;
    esac
  done <"$tmp/files"

  GIT_INDEX_FILE=$index git read-tree "$state"
  # Paths in the patch are relative to the top level, and git apply run from a
  # subdirectory silently skips everything outside it.
  GIT_INDEX_FILE=$index git -C "$top" apply --cached --unidiff-zero --whitespace=nowarn "$patch" 2>"$tmp/apply.err" || {
    cat "$tmp/apply.err" >&2
    die "the patch does not apply to what you approved"
  }
  tree=$(GIT_INDEX_FILE=$index git write-tree)
  set --
  while IFS=$'\t' read -r old path; do
    set -- "$@" ":(top,literal)$path"
  done <"$tmp/files"
  seen=$(overlay_tree "$(seen_tree)" "$worktree" "$@")
  write_ref "$tree" "$seen" "$base"

  while IFS=$'\t' read -r old path; do
    approved=$(git rev-parse -q --verify "$state:$path" || echo "$zero")
    current=$(git rev-parse -q --verify "$worktree:$path" || echo "$zero")
    if [ "$approved" = "$current" ]; then
      echo "approved $path"
    else
      echo "approved part of $path"
    fi
  done <"$tmp/files"
}

case "${1:-}" in
-h | --help | help)
  usage
  exit 0
  ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git work tree"
top=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --absolute-git-dir)
branch=$(git symbolic-ref -q --short HEAD) || die "HEAD is detached; check out a branch first"
ref="refs/review/$branch"
base_key="branch.$branch.reviewBase"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
state=$(git rev-parse -q --verify "$ref" || echo "$zero")
base=""
tmp=$(mktemp -d "${TMPDIR:-/tmp}/git-vibecheck.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

case "${1:-}" in
"") cmd_start "" ;;
--base)
  [ $# -eq 2 ] || die "usage: git vibecheck --base <branch>"
  cmd_start "$2"
  ;;
--base=*)
  [ $# -eq 1 ] || die "usage: git vibecheck --base <branch>"
  cmd_start "${1#--base=}"
  ;;
pending)
  shift
  cmd_pending "$@"
  ;;
approve)
  shift
  cmd_approve "$@"
  ;;
unapprove)
  shift
  cmd_unapprove "$@"
  ;;
pending-diff)
  shift
  cmd_pending_diff "$@"
  ;;
approve-patch)
  shift
  cmd_approve_patch "$@"
  ;;
*)
  usage >&2
  exit 2
  ;;
esac
